# embed_resources.cmake — embed the `!!!WrathClassicAPI` addon as a Win32
# RCDATA resource.
#
# Runs at configure time. It writes two files into OUT_DIR:
#
#   embedded.rc           one `<id> RCDATA "<path>"` line; rc.exe reads the
#                         gzipped pack from disk.
#   embedded_resources.h  the resource ID and each file's place in the pack,
#                         which the DLL loads through src/embed/Resource.h:
#
#     namespace Addons::Embedded::Manifest {
#         constexpr int kResourceId = 1;
#         struct File { const char *path; int index; };
#         constexpr File kFiles[] = { ... };
#         constexpr size_t kFileCount = ...;
#     }
#
# The resource is a pack: one gzip stream of all the addon's files, which
# pack_files.cmake joins at build time into `OUT_DIR/embed/<addon>.pack.gz`.
# A pack compresses each file against the files before it, so the addon text
# packs to about a quarter of its size. The DLL inflates the whole pack with
# the engine's zlib on first use (src/embed/Resource.cpp).
#
# File paths are relative to the addon folder, in backslash form
# (`Util\Constants.lua`) — what src/addons/Embedded.cpp leaves after it
# strips `Interface\AddOns\<addon>\` from the path the engine asks for. The
# DLL compares them ignoring case. A file's index is its place in the pack,
# which is in path order.
#
# The `.toc` is the one file that is not embedded verbatim: its
# `## Version:` line is stamped with ADDON_VERSION into a copy under OUT_DIR,
# so a release build is a pure function of `-DWRATHCLASSICAPI_TAG` and the
# source toc stays `DEV`. The developer marker `.wrathclassicapi-dev` is never
# embedded: it must reflect on-disk presence only (see DiskHasDevMarker in
# src/addons/Embedded.cpp).
#
# Rebuild triggers: adding or removing a file reconfigures through the
# CONFIGURE_DEPENDS glob; editing the toc reconfigures through
# CMAKE_CONFIGURE_DEPENDS; editing any other file re-packs the addon through
# the pack's custom command, which recompiles the .rc through its
# OBJECT_DEPENDS.
#
# Usage:
#   embed_resources(TARGET <t> ADDON_DIR <dir> ADDON_VERSION <v> OUT_DIR <dir>)

set(_EMBED_PACK_SCRIPT "${CMAKE_CURRENT_LIST_DIR}/pack_files.cmake")

# Write `content` to `path` only when it differs, so an unchanged
# reconfigure does not touch the file and trigger a rebuild.
function(_embed_write_if_changed path content)
    set(tmp "${path}.tmp")
    file(WRITE "${tmp}" "${content}")
    configure_file("${tmp}" "${path}" COPYONLY)
    file(REMOVE "${tmp}")
endfunction()

function(embed_resources)
    cmake_parse_arguments(E "" "TARGET;ADDON_DIR;ADDON_VERSION;OUT_DIR" "" ${ARGN})

    get_filename_component(addon "${E_ADDON_DIR}" NAME)
    set(id 1)

    file(GLOB_RECURSE files CONFIGURE_DEPENDS RELATIVE "${E_ADDON_DIR}" "${E_ADDON_DIR}/*")
    list(FILTER files EXCLUDE REGEX "(^|/)\\.wrathclassicapi-dev$")
    list(SORT files) # deterministic indexes

    # The pack's file list reaches pack_files.cmake through a generated list
    # file: the addon's paths are too long for one command line.
    set(paths "set(FILES\n")
    set(inputs "")
    set(manifest "")
    set(index 0)
    foreach(rel ${files})
        set(abs "${E_ADDON_DIR}/${rel}")
        if(rel MATCHES "\\.toc$")
            file(READ "${abs}" toc)
            string(REGEX REPLACE "## Version:[^\n\r]*"
                   "## Version: ${E_ADDON_VERSION}" toc "${toc}")
            set(stamped "${E_OUT_DIR}/embed/${rel}")
            _embed_write_if_changed("${stamped}" "${toc}")
            set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${abs}")
            set(abs "${stamped}")
        endif()
        list(APPEND inputs "${abs}")
        string(APPEND paths "    [==[${abs}]==]\n")
        string(REPLACE "/" "\\\\" rel_bs "${rel}")
        string(APPEND manifest "    { \"${rel_bs}\", ${index} },\n")
        math(EXPR index "${index} + 1")
    endforeach()
    string(APPEND paths ")\n")

    set(pack "${E_OUT_DIR}/embed/${addon}.pack")
    _embed_write_if_changed("${pack}.cmake" "${paths}")
    add_custom_command(
        OUTPUT "${pack}.gz"
        COMMAND "${CMAKE_COMMAND}" "-DLIST=${pack}.cmake" "-DOUT=${pack}.gz"
                -P "${_EMBED_PACK_SCRIPT}"
        DEPENDS ${inputs} "${pack}.cmake" "${_EMBED_PACK_SCRIPT}"
        VERBATIM)

    _embed_write_if_changed("${E_OUT_DIR}/embedded.rc"
"// Generated by cmake/embed_resources.cmake - do not edit.

${id} RCDATA \"${pack}.gz\"
")
    _embed_write_if_changed("${E_OUT_DIR}/embedded_resources.h"
"// Generated by cmake/embed_resources.cmake — do not edit.
// The RCDATA resource in embedded.rc that packs the `${addon}` addon, and
// each embedded file's place in it. Load them through src/embed/Resource.h.

#pragma once

#include <cstddef>

namespace Addons::Embedded::Manifest {

constexpr int kResourceId = ${id};

struct File {
    const char *path; // relative to the addon folder
    int index;        // its place in the pack
};

constexpr File kFiles[] = {
${manifest}};

constexpr size_t kFileCount = sizeof(kFiles) / sizeof(kFiles[0]);

} // namespace Addons::Embedded::Manifest
")

    add_custom_target(${E_TARGET}_embed DEPENDS "${pack}.gz")
    add_dependencies(${E_TARGET} ${E_TARGET}_embed)
    target_sources(${E_TARGET} PRIVATE "${E_OUT_DIR}/embedded.rc")
    set_source_files_properties("${E_OUT_DIR}/embedded.rc" PROPERTIES
        OBJECT_DEPENDS "${pack}.gz")
endfunction()
